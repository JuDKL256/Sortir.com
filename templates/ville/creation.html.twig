{% extends 'base.html.twig' %}

{% block title %}Créer une sortie ! | {{ parent() }}{% endblock %}

{% block body %}

    <h2>Ajoute un lieu !</h2>

    {{ form_start(villeForm) }}
    {{ form_row(villeForm.nom) }}
    {{ form_row(villeForm.codePostal) }}

    <button type="submit" class="btn btn-sm btn-primary">
        {{ villeForm.vars.value.id == null ? 'Create' : 'Modify' }}
    </button>
    {{ form_end(villeForm) }}
{% endblock %}
