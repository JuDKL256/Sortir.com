{% extends 'base.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block body %}
    <div class="container d-flex justify-content-center mt-5 position-relative">

        <div class="card shadow-lg p-4 rounded-lg bg-black border-3 text-center"
             style="margin-top: 7rem; max-width: 500px; width: 100%; border-radius: 20px; border-color: darkorange;">
            <div class="card-body text-center">
                <h2 class="card-title mb-3 fw-bold text-white">{{ participant.username }}</h2>

                <!-- Photo de profil -->
                <div class="mb-3">
                    {% if participant.photoProfile %}
                        <img src="{{ asset('img/photoDeProfil/' ~ participant.photoProfile) }}"
                             class="rounded-circle shadow-sm"
                             style="border: 5px solid darkorange; width: 250px; height: 250px; object-fit: cover;"/>
                    {% else %}
                        <img src="{{ asset('img/profiledefault.png') }}" alt="Photo par défaut"
                             class="rounded-circle shadow-sm"
                             style="border: 5px solid darkorange; width: 250px; height: 250px; object-fit: cover;">
                    {% endif %}
                </div>

                <!-- Infos utilisateur -->
                <ul class="list-group list-group-flush">
                    <li class="list-group-item bg-transparent text-white"><strong>Pseudo :</strong> {{ participant.username }}</li>
                    <li class="list-group-item bg-transparent text-white"><strong>Prénom :</strong> {{ participant.prenom }}</li>
                    <li class="list-group-item bg-transparent text-white"><strong>Nom :</strong> {{ participant.nom }}</li>
                    <li class="list-group-item bg-transparent text-white"><strong>Téléphone :</strong> {{ participant.telephone }}</li>
                    <li class="list-group-item bg-transparent text-white"><strong>Email :</strong> {{ participant.mail }}</li>
                </ul>

                {% if is_granted('ROLE_ADMIN') %}
                    <!-- Section des contrôles administratifs -->
                    <div class="mt-4">
                        <h5 class="text-white border-bottom pb-2 mb-3">Paramètres du compte</h5>

                        <!-- Switches améliorés dans une présentation en grille -->
                        <div class="row g-3">
                            <!-- Switch Statut Actif/Inactif -->
                            <div class="col-12">
                                <div class="card bg-black">
                                    <div class="card-body d-flex justify-content-between align-items-center py-2 bg-black" style="border: 2px solid darkorange;border-radius: 20px">
                                        <div class="d-flex align-items-center">
                                            <span class="text-white me-2 fw-bold">Statut :</span>
                                            <span id="statusBadge" class="badge {{ participant.actif ? 'bg-success' : 'bg-danger' }}">
                                                {{ participant.actif ? 'Actif' : 'Inactif' }}
                                            </span>
                                        </div>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="statusSwitch"
                                                   data-url="{{ path('toggle_status', {'id': participant.id}) }}"
                                                    {{ participant.actif ? 'checked' : '' }}>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Switch Rôle Admin -->
                            <div class="col-12">
                                <div class="card bg-black">
                                    <div class="card-body d-flex justify-content-between align-items-center py-2 bg-black" style="border: 2px solid darkorange;border-radius: 20px">
                                        <div class="d-flex align-items-center">
                                            <span class="text-white me-2 fw-bold">Rôle Admin :</span>
                                            <span id="adminBadge" class="badge {{ 'ROLE_ADMIN' in participant.roles ? 'bg-success' : 'bg-danger' }}">
                                                {{ 'ROLE_ADMIN' in participant.roles ? 'Oui' : 'Non' }}
                                            </span>
                                        </div>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="adminSwitch"
                                                   data-url="{{ path('toggle_admin_role', {'id': participant.id}) }}"
                                                    {{ 'ROLE_ADMIN' in participant.roles ? 'checked' : '' }}>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <script>
        // Toggle du statut actif/inactif avec AJAX
        document.getElementById('statusSwitch').addEventListener('change', function () {
            fetch(this.dataset.url, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
                .then(response => response.json()) // Vérifier que la réponse est bien en JSON
                .then(data => {
                    if (data.success) {
                        let statusBadge = document.getElementById('statusBadge');
                        if (data.newStatus) {
                            statusBadge.classList.remove('bg-danger');
                            statusBadge.classList.add('bg-success');
                            statusBadge.textContent = 'Actif';
                        } else {
                            statusBadge.classList.remove('bg-success');
                            statusBadge.classList.add('bg-danger');
                            statusBadge.textContent = 'Inactif';
                        }
                    }
                })
                .catch(error => console.error("Erreur lors du changement de statut :", error));
        });

        // Toggle du rôle Admin avec AJAX
        document.getElementById('adminSwitch').addEventListener('change', function () {
            const isAdmin = this.checked;
            fetch(this.dataset.url, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
                .then(response => response.json()) // Vérifier que la réponse est bien en JSON
                .then(data => {
                    if (data.success) {
                        let adminBadge = document.getElementById('adminBadge');
                        if (isAdmin) {
                            adminBadge.classList.remove('bg-danger');
                            adminBadge.classList.add('bg-success');
                            adminBadge.textContent = 'Oui';
                        } else {
                            adminBadge.classList.remove('bg-success');
                            adminBadge.classList.add('bg-danger');
                            adminBadge.textContent = 'Non';
                        }
                        console.log('Rôle Admin mis à jour');
                    }
                })
                .catch(error => console.error("Erreur lors du changement de rôle Admin :", error));
        });
    </script>
{% endblock %}