{% extends 'base.html.twig' %}

{% block body %}
    <div class="container d-flex justify-content-center align-items-center vh-100">
        <div class="card shadow-lg p-5 rounded-lg bg-black border-3 text-center"
             style="max-width: 750px; width: 100%; border-radius: 30px; border-color: darkorange;">
            <div class="card-body">
                <!-- Titre de l'erreur -->
                <h1 class="fw-bold text-white display-4">⚠️ Une erreur est survenue !</h1>

                <!-- Image fun et responsive -->
                <div class="d-flex justify-content-center">
                    <img src="{{ asset('img/disaster-girl01589092454 (1).png') }}" alt="Erreur générale"
                         class="img-fluid my-4 responsive-image"
                         style="border-radius: 20px; border: 4px solid darkorange;">
                </div>

                <!-- Texte humoristique -->
                <p class="text-white fs-5">
                    Oups... quelque chose s'est mal passé. 😵‍💫
                    <br><br>
                    Peut-être que les serveurs ont pris une pause café ☕, ou que le système a décidé de faire une sieste. 😴
                </p>

                <!-- Bouton de retour -->
                <a href="{{ path('app_acceuil') }}" class="btn btn-outline-warning fw-bold btn-lg">
                    🔄 Retourner à l'accueil
                </a>
            </div>
        </div>
    </div>

    <style>
        .responsive-image {
            max-width: 100%;
            height: auto;
        }
    </style>
{% endblock %}
