{% extends 'base.html.twig' %}

{% block title %}Créer une ville ! | {{ parent() }}{% endblock %}

{% block body %}
    <div class="container mt-5" style="max-width: 600px;">
        <div class="card shadow-lg p-4 rounded-lg bg-black border-3" style="border-radius: 20px; border-color: darkorange;">
            <div class="card-body">
                <h2 class="card-title text-center text-white fw-bold mb-4">Ajoute une ville !</h2>

                {{ form_start(villeForm) }}

                <div class="mb-3 row">
                    <div class="col-4">
                        {{ form_label(villeForm.nom, 'Nom de la ville', {'label_attr': {'class': 'form-label text-white fw-bold'}}) }}
                    </div>
                    <div class="col-8">
                        {{ form_widget(villeForm.nom, {'attr': {'class': 'form-control border border-dark'}}) }}
                    </div>
                </div>

                <div class="mb-3 row">
                    <div class="col-4">
                        {{ form_label(villeForm.codePostal, 'Code postal', {'label_attr': {'class': 'form-label text-white fw-bold'}}) }}
                    </div>
                    <div class="col-8">
                        {{ form_widget(villeForm.codePostal, {'attr': {'class': 'form-control border border-dark'}}) }}
                    </div>
                </div>

                <button type="submit"  class="btn w-100 fw-bold custom-hover border" style="color: darkorange">
                    {{ villeForm.vars.value.id == null ? 'Create' : 'Modify' }}
                </button>

                {{ form_end(villeForm) }}
            </div>
        </div>
    </div>

    <style>
        .custom-hover:hover {
            background-color: darkorange !important;
            color: black !important;
            border-color: darkorange !important;
        }
    </style>
{% endblock %}
