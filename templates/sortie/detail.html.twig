{% extends 'base.html.twig' %}

{% block body %}
    <div class="container mt-5">
        <!-- Carte de détail de la sortie -->
        <div class="card shadow-lg border-3 mb-4 text-white" style="margin-top: 6rem; border-color: darkorange; background-color: #000;">
            <div class="card-body p-4">
                <h2 class="card-title text-center fw-bold ">{{ sortie.nom }}</h2>
                <p class="text-center fw-bold text-white">📍 {{ sortie.lieu.nom }}</p>

                <!-- Infos principales -->
                <div class="mt-3">
                    <p><strong>Organisé par :</strong> {{ sortie.organisateur.prenom }}    {{ sortie.organisateur.nom }}</p>
                    <p><strong>Date :</strong> {{ sortie.dateHeureDebut | date('d/m/Y H:i') }}</p>
                    <p><strong>Description :</strong> {{ sortie.infosSortie }}</p>
                </div>

                <!-- Liste des Participants -->
                <div class="mt-4">
                    <h4 class="fw-bold"style="color: darkorange">Participants :</h4>
                    <div class="table-responsive">
                        <table class="table table-dark table-hover text-center">
                            <thead class="table-warning text-dark">
                            <tr>
                                <th>Nom</th>
                                <th>Prénom</th>
                                <th>Pseudo</th>
                                <th>Site</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for participant in sortie.participants %}
                                <tr>
                                    <td>
                                        <a href="{{ path('profil_utilisateur', {id: participant.id}) }}" class=" fw-bold"style="color: darkorange">
                                            {{ participant.prenom }}
                                        </a>
                                    </td>
                                    <td>{{ participant.nom }}</td>
                                    <td>{{ participant.username }}</td>
                                    <td>{{ participant.site.nom }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Boutons d'actions -->
                <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
                    <a href="{{ path('sortie_delete', {'id': sortie.id, '_token': csrf_token('delete' ~ sortie.id)}) }}"
                       class="btn  custom-hover border fw-bold" style="color: darkorange">❌ Supprimer</a>

                    {% if app.user in sortie.participants %}
                        <a href="{{ path('desinscription', {'id': sortie.id, '_token': csrf_token('desinscription' ~ sortie.id)}) }}"
                           class="btn custom-hover border fw-bold" style="color: darkorange">🚫 Me désinscrire</a>
                    {% endif %}

                    {% if sortie.participants.count < sortie.nbInscriptionMax and app.user not in sortie.participants and sortie.dateLimiteInscription > date('now') %}
                        <a href="{{ path('sortie_inscription', {'id': sortie.id, '_token': csrf_token('inscription' ~ sortie.id)}) }}"
                           class="btn  border custom-hover fw-bold" style="color: darkorange">✅ Je participe</a>
                    {% endif %}

                    {% if app.user == sortie.organisateur %}
                        <a href="{{ path('annulation', {'id': sortie.id, '_token': csrf_token('annulation' ~ sortie.id)}) }}"
                           class="btn btn-dark border custom-hover fw-bold" style="color: darkorange">❌ Annuler</a>
                    {% endif %}

                    <a href="{{ path('sortie_update', {'id': sortie.id}) }}" class="btn border custom-hover fw-bold" style="color: darkorange">✏️ Modifier</a>
                </div>
            </div>
        </div>
    </div>

    <style>
        /* Hover personnalisé */
        .custom-hover:hover {
            background-color: darkorange !important;
            color: black !important;
            border-color: darkorange !important;
        }
    </style>
{% endblock %}
