{% extends 'base.html.twig' %}

{% block body %}

        <table class="sorties-table">
            <thead>
            <tr>
                <th>Nom</th>
                <th>Code postal</th>


            </tr>
            </thead>
            <tbody>
            {% for ville in villes %}
                    <tr>
                        <td>{{ ville.nom }}</td>
                        <td>{{ ville.codePostal }}</td>
                    </tr>
            {% endfor %}
            </tbody>
        </table>
{% endblock %}