{% extends 'base.html.twig' %}

{% block body %}
    <div class="container mt-5">
        <h1 class="text-center fw-bold text-white">Filtrer les sorties</h1>

        <!-- Formulaire de recherche -->
        <div class="card p-4 shadow-lg border-3 mb-4" style="border-color: darkorange; background-color: #000;">
            {{ form_start(searchForm, {'attr': {'class': 'search-form'}}) }}

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label text-white">{{ form_label(searchForm.site) }}</label>
                    {{ form_widget(searchForm.site, {'attr': {'class': 'form-control'}}) }}
                </div>

                <div class="col-md-6">
                    <label class="form-label text-white">{{ form_label(searchForm.nom) }}</label>
                    {{ form_widget(searchForm.nom, {'attr': {'class': 'form-control'}}) }}
                </div>

                <div class="col-md-6">
                    <label class="form-label text-white">{{ form_label(searchForm.dateDebut) }}</label>
                    {{ form_widget(searchForm.dateDebut, {'attr': {'class': 'form-control'}}) }}
                </div>

                <div class="col-md-6">
                    <label class="form-label text-white">{{ form_label(searchForm.dateFin) }}</label>
                    {{ form_widget(searchForm.dateFin, {'attr': {'class': 'form-control'}}) }}
                </div>

                <div class="col-12 d-flex flex-wrap gap-3 text-white">
                    {{ form_widget(searchForm.organisateur) }} {{ form_label(searchForm.organisateur) }}
                    {{ form_widget(searchForm.inscrit) }} {{ form_label(searchForm.inscrit) }}
                    {{ form_widget(searchForm.nonInscrit) }} {{ form_label(searchForm.nonInscrit) }}
                    {{ form_widget(searchForm.sortiesPassees) }} {{ form_label(searchForm.sortiesPassees) }}
                </div>

                <div class="col-12 text-center">
                    {{ form_widget(searchForm.rechercher, {'attr': {'class': 'btn btn-primary custom-hover w-50 fw-bold'}}) }}
                </div>
            </div>

            {{ form_end(searchForm) }}
        </div>

        <!-- Liste des sorties sous forme de cartes -->
        <div class="row row-cols-1 row-cols-md-2 g-4">
            {% for sortie in sorties %}
                <div class="col">
                    <div class="card shadow-lg border-3 text-white" style="border-color: darkorange; background-color: #000;">
                        <div class="card-body p-4">
                            <!-- Nom & Site -->
                            <div class="d-flex justify-content-between align-items-center">
                                <h4 class="fw-bold">
                                    <a href="{{ path('sortie_detail', {'id': sortie.id}) }}" class="text-decoration-none text-white">
                                        {{ sortie.nom }}
                                    </a>
                                </h4>
                                <span class="badge bg-secondary">{{ sortie.site.nom }}</span>
                            </div>

                            <!-- Infos principales -->
                            <div class="mt-3">
                                <p><strong>Date :</strong> {{ sortie.dateHeureDebut|date('d/m/Y H:i') }}</p>
                                <p><strong>Clôture :</strong> {{ sortie.dateLimiteInscription|date('d/m/Y') }}</p>
                                <p><strong>Places :</strong> {{ sortie.Participants|length }}/{{ sortie.nbInscriptionMax }}</p>
                                <p><strong>État :</strong> <span class="badge {{ sortie.etat.libelle == 'Ouvert' ? 'bg-success' : 'bg-danger' }}">{{ sortie.etat.libelle }}</span></p>
                            </div>

                            <!-- Statut & Organisateur -->
                            <div class="d-flex justify-content-between align-items-center">
                                <p class="mb-0"><strong>Organisateur :</strong> {{ sortie.Organisateur.username }}</p>
                                <p class="mb-0">
                                    {% if app.user in sortie.Participants %}
                                        ✅ Inscrit
                                    {% endif %}
                                </p>
                            </div>

                            <!-- Bouton Afficher -->
                            <div class="text-center mt-3">
                                <a href="{{ path('sortie_detail', {'id': sortie.id}) }}" class="btn btn-dark custom-hover w-100 fw-bold">
                                    Voir les détails
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    <style>
        /* Hover personnalisé */
        .custom-hover:hover {
            background-color: darkorange !important;
            color: black !important;
            border-color: darkorange !important;
        }

        /* Lien du titre */
        .card-title a:hover {
            color: darkorange !important;
            text-decoration: underline !important;
        }

        /* Ajustement des badges */
        .badge {
            font-size: 0.9rem;
            padding: 0.5em 1em;
        }
    </style>
{% endblock %}
