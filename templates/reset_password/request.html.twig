{% extends 'base.html.twig' %}

{% block title %}Réinitialiser votre mot de passe{% endblock %}

{% block body %}
    <div class="container d-flex justify-content-center mt-5">
        <div class="card shadow-lg p-4 rounded-lg bg-black border-3" style="max-width: 500px; width: 100%; border-radius: 20px; border-color: darkorange;">
            <div class="card-body">
                <h1 class="h3 mb-3 text-center text-white fw-bold">Réinitialiser votre mot de passe</h1>

                {% for flash_error in app.flashes('reset_password_error') %}
                    <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
                {% endfor %}

                <!-- Formulaire de réinitialisation du mot de passe -->
                {{ form_start(requestForm) }}

                <div class="mb-3 row d-flex align-items-center">
                    <div class="col-4">
                        {{ form_label(requestForm.mail, 'Email', {'label_attr': {'class': 'form-label text-white fw-bold'}}) }}
                    </div>
                    <div class="col-8">
                        {{ form_widget(requestForm.mail, {'attr': {'class': 'form-control border border-dark w-100'}}) }}
                    </div>
                </div>

                <div>
                    <small class="text-white">
                        Entrez votre adresse e-mail, et nous vous enverrons un lien pour réinitialiser votre mot de passe.
                    </small>
                </div>

                <div class="d-flex justify-content-center mt-4">
                    <button class="btn btn-lg btn-primary w-100 fw-bold custom-hover" type="submit">Envoyer le lien de réinitialisation</button>
                </div>

                {{ form_end(requestForm) }}
            </div>
        </div>
    </div>

    <style>
        /* Effet hover personnalisé pour le bouton */
        .custom-hover:hover {
            background-color: darkorange !important;
            color: black !important;
            border-color: darkorange !important;
        }
    </style>
{% endblock %}
