{% extends 'base.html.twig' %}

{% block title %}
    E-mail de réinitialisation du mot de passe envoyé{% endblock %}

{% block body %}
    <div class="container d-flex justify-content-center mt-5 position-relative">
        <div class="card shadow-lg p-4 rounded-lg bg-black border-3 text-center"
             style="margin-top: 7rem; max-width: 500px; width: 100%; border-radius: 20px; border-color: darkorange;">
            <div class="card-body text-center">
                <h2 class="card-title mb-3 fw-bold "style="color: darkorange">
                    Réinitialisation du mot de passe</h2>

                <p class="text-white">
                    Si un compte correspondant à votre adresse e-mail existe, un e-mail contenant un lien pour réinitialiser votre mot de passe vous a été envoyé.
                    Ce lien expirera dans

                    <strong  style="color: darkorange">{{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}</strong>.
                </p>

                <p class="text-white">
                    Si vous ne recevez pas d’e-mail, veuillez vérifier votre dossier spam ou réessayer.</p>

                <a href="{{ path('app_forgot_password_request') }}" class="btn c fw-bold mt-3 px-4" style="color:black; background-color: darkorange">Try Again</a>
            </div>
        </div>
    </div>
{% endblock %}
