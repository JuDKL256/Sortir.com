{% extends 'base.html.twig' %}

{% block body %}
    <div class="container d-flex justify-content-center align-items-center vh-100">
        <div class="card shadow-lg p-5 rounded-lg bg-black border-3 text-center"
             style="max-width: 750px; width: 100%; border-radius: 30px; border-color: darkorange;">
            <div class="card-body">
                <!-- Titre de l'erreur -->
                <h1 class="fw-bold text-white display-4">🚧 Accès refusé !</h1>

                <!-- Image fun et responsive -->
                <div class="d-flex justify-content-center">
                    <img src="{{ asset('img/risitas2.jpeg') }}" alt="Accès refusé"
                         class="img-fluid my-4 responsive-image"
                         style="border-radius: 20px; border: 4px solid darkorange;">
                </div>

                <!-- Texte humoristique -->
                <p class="text-white fs-5">
                    Oups... il semblerait que vous n'ayez pas les autorisations pour entrer ici. 🤔
                    <br><br>
                    Essayez de contacter un administrateur... ou bien tentez un **sortilège d'invisibilité**. 🧙‍♂️✨
                </p>

                <!-- Bouton de retour -->
                <a href="{{ path('app_acceuil') }}" class="btn btn-outline-warning fw-bold btn-lg">
                    🔙 Retour en lieu sûr
                </a>
            </div>
        </div>
    </div>

    <style>
        .responsive-image {
            max-width: 100%;
            height: auto;
        }
    </style>
{% endblock %}
