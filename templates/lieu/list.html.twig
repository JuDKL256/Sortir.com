{% extends 'base.html.twig' %}

{% block title %}Liste des Lieux{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="card shadow-lg p-4 rounded-lg bg-black border-3" style="border-radius: 20px; border-color: darkorange;">
            <div class="card-body">
                <h2 class="card-title text-center text-white fw-bold mb-4">Liste des Lieux</h2>
                <table class="table table-striped table-bordered text-white">
                    <thead class="thead-dark">
                    <tr>
                        <th scope="col">Nom du lieu</th>
                        <th scope="col">Rue du lieu</th>
                        <th scope="col">Ville de la sortie</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for lieu in lieux %}
                        <tr>
                            <td>{{ lieu.nom }}</td>
                            <td>{{ lieu.rue }}</td>
                            <td>{{ lieu.ville.nom }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
