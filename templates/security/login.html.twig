{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
    <div class="container d-flex justify-content-center mt-5">
        <div class="card shadow-lg p-4 rounded-lg bg-black border-3" style="max-width: 500px; width: 100%; border-radius: 20px; border-color: darkorange;">
            <div class="card-body">
                <h1 class="h3 mb-3 text-center text-white fw-bold">Connectez-vous</h1>

                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                {% if app.user %}
                    <div class="mb-3">
                        Bienvenue {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}" class="text-white">Déconnexion</a>
                    </div>
                {% endif %}

                <!-- Formulaire de connexion -->
                <form method="post">
                    <div class="mb-3 row d-flex align-items-center">
                        <div class="col-4">
                            <label for="username" class="form-label text-white fw-bold">Identifiant</label>
                        </div>
                        <div class="col-8">
                            <input type="text" value="{{ last_username }}" name="_username" id="username" class="form-control border border-dark w-100" autocomplete="username" required autofocus>
                        </div>
                    </div>

                    <div class="mb-3 row d-flex align-items-center">
                        <div class="col-4">
                            <label for="password" class="form-label text-white fw-bold">Mot de passe</label>
                        </div>
                        <div class="col-8">
                            <input type="password" name="_password" id="password" class="form-control border border-dark w-100" autocomplete="current-password" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    </div>

                    <div class="mb-3 row d-flex align-items-center">
                        <div class="col-12">
                            <div class="form-check">
                                <input type="checkbox" name="_remember_me" id="_remember_me" class="form-check-input">
                                <label for="_remember_me" class="form-check-label text-white fw-bold">Se souvenir de moi</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center mt-4">
                        <button class="btn w-100 fw-bold custom-hover border" style="color: darkorange" type="submit">Se connecter</button>
                    </div>
                </form>

                <div class="mt-3 text-center">
                    <a href="{{ path('app_forgot_password_request') }}" style="color: darkorange">Mot de passe oublié ?</a>
                </div>
            </div>
        </div>
    </div>

    <style>
        /* Effet hover personnalisé pour le bouton */
        .custom-hover:hover {
            background-color: darkorange !important;
            color: black !important;
            border-color: darkorange !important;
        }
    </style>
{% endblock %}
