{% extends 'base.html.twig' %}

{% block title %}Créer un lieu ! | {{ parent() }}{% endblock %}

{% block body %}
    <div class="container mt-5" style="max-width: 600px;">
        <div class="card shadow-lg p-4 rounded-lg bg-black border-3" style="border-radius: 20px; border-color: darkorange;">
            <div class="card-body">
                <h2 class="card-title text-center text-white fw-bold mb-4">Ajoute un lieu !</h2>

                {{ form_start(lieuForm) }}

                <div class="mb-3 row">
                    <div class="col-4">
                        {{ form_label(lieuForm.nom, 'Nom du lieu', {'label_attr': {'class': 'form-label text-white fw-bold'}}) }}
                    </div>
                    <div class="col-8">
                        {{ form_widget(lieuForm.nom, {'attr': {'class': 'form-control border border-dark'}}) }}
                    </div>
                </div>

                <div class="mb-3 row">
                    <div class="col-4">
                        {{ form_label(lieuForm.rue, 'Rue du lieu', {'label_attr': {'class': 'form-label text-white fw-bold'}}) }}
                    </div>
                    <div class="col-8">
                        {{ form_widget(lieuForm.rue, {'attr': {'class': 'form-control border border-dark'}}) }}
                    </div>
                </div>

                <div class="mb-3 row">
                    <div class="col-4">
                        {{ form_label(lieuForm.latitude, 'Latitude', {'label_attr': {'class': 'form-label text-white fw-bold'}}) }}
                    </div>
                    <div class="col-8">
                        {{ form_widget(lieuForm.latitude, {'attr': {'class': 'form-control border border-dark'}}) }}
                    </div>
                </div>

                <div class="mb-3 row">
                    <div class="col-4">
                        {{ form_label(lieuForm.longitude, 'Longitude', {'label_attr': {'class': 'form-label text-white fw-bold'}}) }}
                    </div>
                    <div class="col-8">
                        {{ form_widget(lieuForm.longitude, {'attr': {'class': 'form-control border border-dark'}}) }}
                    </div>
                </div>

                <div class="mb-3 row">
                    <div class="col-4">
                        {{ form_label(lieuForm.ville, 'Ville', {'label_attr': {'class': 'form-label text-white fw-bold'}}) }}
                    </div>
                    <div class="col-8">
                        {{ form_widget(lieuForm.ville, {'attr': {'class': 'form-control border border-dark'}}) }}
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 fw-bold custom-hover">
                    {{ lieuForm.vars.value.id == null ? 'Create' : 'Modify' }}
                </button>

                {{ form_end(lieuForm) }}
            </div>
        </div>
    </div>

    <style>
        .custom-hover:hover {
            background-color: darkorange !important;
            color: black !important;
            border-color: darkorange !important;
        }
    </style>
{% endblock %}
