{% extends 'base.html.twig' %}

{% block title %}Liste des Lieux{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="card shadow-lg p-4 rounded-lg bg-black border-3" style="border-radius: 20px; border-color: darkorange;">
            <div class="card-body">
                <h2 class="card-title text-center text-white fw-bold mb-4 ">Liste des Lieux</h2>
                <table class="table table-striped table-bordered text-white">
                    <thead class="thead-dark">
                    <tr>
                        <th scope="col" class="text-black"style="background-color: darkorange">Nom du lieu</th>
                        <th scope="col" class="text-black"style="background-color: darkorange">Rue du lieu</th>
                        <th scope="col" class="text-black"style="background-color: darkorange">Ville de la sortie</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for lieu in lieux %}
                        <tr>
                            <td class=" fw-bold bg-black text-white">{{ lieu.nom }}</td>
                            <td class="bg-black text-white">{{ lieu.rue }}</td>
                            <td class="bg-black text-white">{{ lieu.ville.nom }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
